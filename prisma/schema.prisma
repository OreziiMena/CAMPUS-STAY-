generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  AGENT
  ADMIN
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  phone             String
  password          String
  role              Role            @default(STUDENT)
  isEmailVerified   Boolean         @default(false)
  tokenVersion      Int             @default(1)
  deletedAt         DateTime?
  
  // Two-Factor Authentication (2FA) for Admins & Agents
  twoFactorEnabled     Boolean         @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]        @default([])
  twoFactorConfirmedAt DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  // Profile associations
  studentProfile    StudentProfile?
  agentProfile      AgentProfile?

  // Inquiries sent (for students) and received (for agents)
  inquiries                   Inquiry[]           @relation(name: "StudentInquiries")
  receivedInquiries           Inquiry[]           @relation(name: "AgentReceivedInquiries")
  viewings                    Viewing[]

  // Availability Queries
  studentAvailabilityQueries  AvailabilityQuery[] @relation(name: "StudentAvailabilityQueries")
  agentAvailabilityQueries    AvailabilityQuery[] @relation(name: "AgentAvailabilityQueries")

  // Inspection Payments
  inspectionPaymentsSent      InspectionPayment[] @relation(name: "StudentInspectionPayments")
  inspectionPaymentsReceived  InspectionPayment[] @relation(name: "AgentInspectionPayments")

  // Chat Room Associations
  studentChatRooms  ChatRoom[]      @relation(name: "StudentChatRooms")
  agentChatRooms    ChatRoom[]      @relation(name: "AgentChatRooms")
  messagesSent      Message[]
  reportsSubmitted  Report[]        @relation(name: "UserReports")
  activityLogs      ActivityLog[]
}

model StudentProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String
  university          String
  username            String   @unique
  preferences         Json?    // Preferences object (budget, roommate preferences, layout type, etc.)
  properties          Property[]
  reports             Report[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AgentProfile {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  address     String?    // Office/Business address
  agencyName  String?
  bio         String?
  isVerified  Boolean    @default(false)
  
  // Paystack Bank & Transfer Details
  bankCode      String?
  bankName      String?
  accountNumber String?
  accountName   String?
  recipientCode String?  // Paystack Transfer Recipient code (e.g. RCP_...)

  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Property {
  id           String       @id @default(uuid())
  title        String
  hostelType   String       // e.g., Self-Contain, Single Room, 2-Bedroom Flat
  price               Float
  rentAmount          Float?
  agentFee            Float?          @default(0)
  cautionFee          Float?          @default(0)
  isNegotiable        Boolean         @default(false)
  location     String
  distance     String       // e.g., "5 mins walk to campus"
  description  String
  amenities    String[]     // Postgres string array
  images       String[]     // Postgres string array
  latitude     Float?
  longitude    Float?
  isAvailable  Boolean      @default(true)
  statusChangedAt DateTime?
  isVerified   Boolean      @default(false)
  views        Int          @default(0)
  university   String       @default("FUPRE")
  
  isRoommateOption    Boolean         @default(false)
  genderPreference    String?         @default("Any")
  
  // Owner Agent
  agentId             String?
  agent               AgentProfile?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  // Owner Student
  studentId           String?
  student             StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Inquiries sent for this property
  inquiries           Inquiry[]
  viewings            Viewing[]
  availabilityQueries AvailabilityQuery[]
  inspectionPayments  InspectionPayment[]
  chatRooms           ChatRoom[]
  reports             Report[]
  
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Inquiry {
  id         String   @id @default(uuid())
  
  // Student who sent the inquiry
  studentId  String
  student    User     @relation(name: "StudentInquiries", fields: [studentId], references: [id], onDelete: Cascade)
  
  // Property queried
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  // Agent who received the inquiry
  agentId    String
  agent      User     @relation(name: "AgentReceivedInquiries", fields: [agentId], references: [id], onDelete: Cascade)
  
  message    String
  createdAt  DateTime @default(now())
}

model Viewing {
  id                    String    @id @default(uuid())
  studentId             String
  student               User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  propertyId            String
  property              Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  dateTime              DateTime
  status                String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  agentInspectionStatus String?   // INSPECTED, RESCHEDULED
  agentInspectionNotes  String?
  studentConfirmedTour  Boolean   @default(false)
  studentConfirmedAt    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model AvailabilityQuery {
  id           String    @id @default(uuid())
  studentId    String
  student      User      @relation(name: "StudentAvailabilityQueries", fields: [studentId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId      String
  agent        User      @relation(name: "AgentAvailabilityQueries", fields: [agentId], references: [id], onDelete: Cascade)
  status       String    @default("PENDING") // PENDING, AVAILABLE, UNAVAILABLE
  token        String    @unique @default(uuid())
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId, propertyId])
  @@index([token])
}

model InspectionPayment {
  id          String    @id @default(uuid())
  studentId   String
  student     User      @relation(name: "StudentInspectionPayments", fields: [studentId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId     String
  agent       User      @relation(name: "AgentInspectionPayments", fields: [agentId], references: [id], onDelete: Cascade)
  amount      Float     @default(10000)
  currency    String    @default("NGN")
  status      String    @default("PAID") // PENDING, PAID, REFUNDED, DISPUTED
  reference   String    @unique
  paidAt      DateTime  @default(now())
  
  // Agent Payout Tracking (50-50 Escrow)
  payoutStatus      String    @default("PENDING") // PENDING, DISBURSED, FAILED
  payoutReference   String?
  payoutDisbursedAt DateTime?

  // Refund & Dispute Tracking
  refundReason      String?
  refundedAt        DateTime?
  disputeReason     String?
  disputedAt        DateTime?

  createdAt   DateTime  @default(now())

  @@index([studentId, propertyId])
  @@index([reference])
}

model ChatRoom {
  id          String    @id @default(uuid())
  studentId   String
  student     User      @relation(name: "StudentChatRooms", fields: [studentId], references: [id], onDelete: Cascade)
  agentId     String
  agent       User      @relation(name: "AgentChatRooms", fields: [agentId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime  @default(now())
  
  @@unique([studentId, agentId, propertyId])
}

model Message {
  id         String   @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model OTP {
  id          String     @id @default(uuid())
  email       String
  code        String     // 6-digit number string
  purpose     OTPPurpose
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([email])
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_AUTH
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  reporter     User         @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  propertyId   String?      // Flagged property (optional)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roommateId   String?      // Flagged roommate listing student profile (optional)
  roommate     StudentProfile? @relation(fields: [roommateId], references: [id], onDelete: Cascade)
  reason       ReportReason
  customReason String?      // For "OTHER" reason choice
  description  String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([propertyId])
  @@index([roommateId])
}

enum ReportReason {
  FRAUD_SCAM
  INACCURATE_DETAILS
  INAPPROPRIATE_CONTENT
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model RateLimit {
  id        String   @id @default(uuid())
  ip        String
  action    String
  createdAt DateTime @default(now())

  @@index([ip, action, createdAt])
}

model ActivityLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName      String
  userEmail     String
  userRole      String   @default("AGENT")
  action        String   // PROPERTY_CREATED, PROPERTY_UPDATED, PROPERTY_DELETED, PROPERTY_AVAILABILITY_TOGGLED
  description   String
  propertyId    String?
  propertyTitle String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorEmail  String
  actorName   String
  actorRole   String   // ADMIN, AGENT, SYSTEM
  action      String   // e.g. PAYOUT_DISBURSED, USER_VERIFIED, REFUND_ISSUED, 2FA_ENABLED, PROPERTY_DELETED, USER_ROLE_UPDATED
  targetType  String   // USER, PROPERTY, PAYMENT, REPORT, BROADCAST, AUTH, SETTINGS
  targetId    String?
  targetLabel String?  // e.g. Student Name, Property Title, Payment Ref
  details     String   // Human-readable summary
  metadata    Json?    // Context payload (amount, bank info, diffs, IP, headers)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model AmbassadorApplication {
  id            String    @id @default(uuid())
  userId        String?
  fullName      String
  email         String    @unique
  phone         String
  university    String
  department    String
  level         String
  socialHandle  String?
  pitch         String
  referralCode  String    @unique
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  referralCount Int       @default(0)
  earnings      Float     @default(0.0)
  payoutInfo    String?

  // Direct Bank Account Details (Paystack NUBAN)
  bankCode      String?
  bankName      String?
  accountNumber String?
  accountName   String?
  recipientCode String?  // Paystack Transfer Recipient code (e.g. RCP_...)

  // Payout History
  payouts       AmbassadorPayout[]

  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([referralCode])
  @@index([status])
  @@index([university])
}

model AmbassadorPayout {
  id            String                @id @default(uuid())
  ambassadorId  String
  ambassador    AmbassadorApplication @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  amount        Float
  reference     String                @unique
  bankName      String
  accountNumber String
  accountName   String
  status        String                @default("SUCCESS") // SUCCESS, PENDING, FAILED
  note          String?
  disbursedAt   DateTime              @default(now())
  createdAt     DateTime              @default(now())

  @@index([ambassadorId])
  @@index([reference])
}


